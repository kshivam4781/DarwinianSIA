# Copy this file to .env and fill in your keys:
#   copy .env.example .env
#
# NEVER commit .env to git.

# Required — Meta + Feedback agents (Claude SDK)
ANTHROPIC_API_KEY=sk-ant-api03-...

# Required — Target agent inference (Nebius Token Factory)
NEBIUS_API_KEY=...

# Optional — Tavily web search (CABS Layer 2 grounding)
TAVILY_API_KEY=tvly-...

# Optional — enable Tavily during sia-cabs runs without --tavily flag
# CABS_ENABLE_TAVILY=1
