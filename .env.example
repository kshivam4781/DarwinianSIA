# Copy this file to .env and fill in your keys:
#   copy .env.example .env
#
# NEVER commit .env to git.
#
# ICML Thesis 1 live stack (Tick 289/308/309): default meta is
# kimi-nebius-pydantic-meta — Nebius covers target + meta/feedback.
# ANTHROPIC is optional unless ICML_META_AGENT_PROFILE=default-meta.

# Required for ICML live G2→G4 — Target + meta/feedback (Nebius Token Factory / Kimi)
NEBIUS_API_KEY=...

# Optional under Tick 289 Nebius pydantic-ai meta (required only with default-meta Claude)
# ANTHROPIC_API_KEY=sk-ant-api03-...

# Required for --fetch-diamond (gated Idavidrein/gpqa) — OR drop local gpqa_diamond.csv
# (see docs/ICML_HUMAN_UNBLOCK.md). HF_TOKEN is not needed when a local CSV is present.
# HF_TOKEN=hf_...

# Optional — Tavily web search (CABS Layer 2 grounding)
TAVILY_API_KEY=tvly-...

# Optional — enable Tavily during sia-cabs runs without --tavily flag
# CABS_ENABLE_TAVILY=1
